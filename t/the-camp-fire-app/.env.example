# Copy this file to .env and fill in the values from your Supabase
# project's dashboard: Settings > API.
#
# VITE_SUPABASE_URL is the "Project URL".
# VITE_SUPABASE_ANON_KEY is the "anon public" key — safe to expose in
# client-side code by design (that's what Row Level Security is for).
# Never put the "service_role" key here or anywhere in frontend code.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

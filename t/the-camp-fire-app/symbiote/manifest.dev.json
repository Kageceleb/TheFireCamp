{
  "manifestVersion": 1,
  "name": "The Camp Fire",
  "summary": "D&D 5e campaign, inventory, and character management",
  "entryPoint": "http://localhost:5173",
  "api": {
    "version": "0.1",
    "initTimeout": 10,
    "subscriptions": {
      "dice": {
        "onRollResults": "handleRollResult"
      },
      "symbiote": {
        "onStateChangeEvent": "handleSymbioteStateChange"
      }
    }
  },
  "environment": {
    "webViewBackgroundColor": "#121110",
    "loadTargetBehavior": "popup"
  }
}
